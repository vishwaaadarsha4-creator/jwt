<!-- index.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple Blogging Site</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">MyBlog</div>

        <ul class="nav-links">
            <li><a href="#">Home</a></li>
            <li><a href="#">Blogs</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <h1>Welcome to My Blogging Site</h1>
        <p>Read amazing blogs and share your thoughts with the world.</p>
        <a href="#" class="btn">Read Blogs</a>
    </section>

    <!-- Blog Section -->
    <section class="blogs">

        <div class="blog-card">
            <img src="https://picsum.photos/300/200?1" alt="blog image">
            <h2>Blog Title One</h2>
            <p>Lorem ipsum dolor sit amet consectetur adipisicing elit.</p>
            <a href="#">Read More</a>
        </div>

        <div class="blog-card">
            <img src="https://picsum.photos/300/200?2" alt="blog image">
            <h2>Blog Title Two</h2>
            <p>Lorem ipsum dolor sit amet consectetur adipisicing elit.</p>
            <a href="#">Read More</a>
        </div>

        <div class="blog-card">
            <img src="https://picsum.photos/300/200?3" alt="blog image">
            <h2>Blog Title Three</h2>
            <p>Lorem ipsum dolor sit amet consectetur adipisicing elit.</p>
            <a href="#">Read More</a>
        </div>

    </section>

    <!-- Footer -->
    <footer class="footer">
        <p>© 2026 MyBlog | All Rights Reserved</p>
    </footer>

</body>
</html>