<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Tasks</title>
    <link rel="stylesheet" href="allTasks.css">
</head>
<body>

    <div class="container">

        <div class="header">
            <h1>My Tasks</h1>
            <a href="/createtask" class="add-btn">+ Add New Task</a>
        </div>

        <div class="task-container">
            <% task.forEach((data)=>{ %>
                            <div class="task-card">
                <h2><%= data.title %></h2>
                <p><%= data.description %></p>

                <span class="status pending"><%= data.status %></span>

                <div class="actions">
                    <a href="#" class="edit">Edit</a>
                    <a href="#" class="delete">Delete</a>
                </div>
            </div>
           <% }); %>




        </div>

    </div>

</body>
</html>