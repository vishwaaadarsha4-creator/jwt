<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Tasks</title>
    <link rel="stylesheet" href="allTasks.css">
</head>
<body>

    <div class="container">

        <div class="header">
            <h1>My Tasks</h1>
            <a href="#" class="add-btn">+ Add New Task</a>
        </div>

        <div class="task-container">

            <div class="task-card">
                <h2>Complete Node.js Assignment</h2>
                <p>Finish CRUD operations and submit the project.</p>

                <span class="status pending">Pending</span>

                <div class="actions">
                    <a href="#" class="edit">Edit</a>
                    <a href="#" class="delete">Delete</a>
                </div>
            </div>

            <div class="task-card">
                <h2>Study Database</h2>
                <p>Practice Sequelize associations and queries.</p>

                <span class="status completed">Completed</span>

                <div class="actions">
                    <a href="#" class="edit">Edit</a>
                    <a href="#" class="delete">Delete</a>
                </div>
            </div>

            <div class="task-card">
                <h2>Prepare Presentation</h2>
                <p>Create slides for project demonstration.</p>

                <span class="status pending">Pending</span>

                <div class="actions">
                    <a href="#" class="edit">Edit</a>
                    <a href="#" class="delete">Delete</a>
                </div>
            </div>

        </div>

    </div>

</body>
</html>